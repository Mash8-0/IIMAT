# ─────────────────────────────────────────────────────────────────────────────
# IIMAT College Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Change this to your PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/iimat_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Change JWT_SECRET to a long random string before deploying to production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
# Change this to your frontend URL in production (e.g. https://iimat.edu.my)
CLIENT_URL=http://localhost:5173
